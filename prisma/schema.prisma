generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
  SUPERVISOR
}

// Tipos de documento de identidad soportados en el registro.
enum DocumentType {
  CC
  CE
  TI
  PASAPORTE
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique

  firstName      String
  lastName       String

  phone          String

  documentType   DocumentType
  documentNumber String         @unique

  // Nacionalidad del usuario. En la UI se presenta temáticamente como
  // "sector de origen" dentro de la red Nexus, pero el dato es un país real.
  nationality    String

  passwordHash   String

  role           Role           @default(USER)

  isActive       Boolean        @default(true)

  refreshTokens  RefreshToken[]
  accessLogs     AccessLog[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([role])
  @@index([isActive])
}

// Zona física/lógica de la estación (Puente de mando, Laboratorio, Muelle de acoplamiento...).
// minRole define el nivel mínimo de autorización requerido para entrar.
model AccessZone {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  minRole     Role         @default(USER)
  isActive    Boolean      @default(true)

  accessLogs  AccessLog[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// Bitácora: cada intento de entrada a una zona, otorgado o denegado.
model AccessLog {
  id           String     @id @default(uuid())

  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  zoneId       String
  zone         AccessZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  granted      Boolean
  attemptedAt  DateTime   @default(now())

  @@index([userId])
  @@index([zoneId])
  @@index([attemptedAt])
}

model RefreshToken {
  id        String    @id @default(uuid())

  tokenHash String    @unique

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}